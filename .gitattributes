# Normalise line endings in the repository, check out LF on every platform.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.ipynb text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Binary artefacts - never touch line endings.
*.pkl binary
*.csv binary
*.png binary
*.jpg binary
*.ico binary
*.mp4 binary
*.mp3 binary
*.wav binary